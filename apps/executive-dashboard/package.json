{
  "name": "nexus-executive-dashboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stitch-theme.mjs --check && vite build && node scripts/stitch-classes.mjs",
    "preview": "vite preview",
    "gate": "npm run build && node QUALITY_GATE.mjs",
    "probe": "node SCHEMA_PROBE.mjs",
    "check": "npm run gate && npm run probe"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "playwright": "^1.44.0",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/container-queries": "^0.1.1"
  }
}
