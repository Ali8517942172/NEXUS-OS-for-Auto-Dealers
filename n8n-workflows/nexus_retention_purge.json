      "name": "Find Expired Documents",
      "id": "c559c9e8-fd7d-4880-a8f8-5f04c09ea4e2",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "alwaysOutputData": true,
      "onError": "stopWorkflow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Aggregate the expired rows into a single bulk delete.\n// `Find Expired Documents` runs with alwaysOutputData, so an empty result\n// arrives as one empty item rather than as no items at all.\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && r.id && r.storage_path);\n\nif (rows.length === 0) return [];   // nothing due — stop this branch quietly\n\nreturn [{ json: {\n  count: rows.length,\n  ids: rows.map(r => r.id),\n  paths: rows.map(r => r.storage_path),\n  oldest_due: rows.map(r => r.retain_until).sort()[0],\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -120
      ],
      "name": "Collect Expired Paths",
      "id": "fffa8f1b-89cd-4269-8008-2d86e5d5603a"
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "https://dsvuoovivysszdoiorch.supabase.co/storage/v1/object/kyc-documents",
