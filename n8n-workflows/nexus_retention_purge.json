      ],
      "name": "Delete Storage Objects",
      "id": "b04ba142-c3b6-466c-b76d-001af291d486",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://dsvuoovivysszdoiorch.supabase.co/rest/v1/kyc_documents?id=in.(' + $('Collect Expired Paths').first().json.ids.join(',') + ')' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
