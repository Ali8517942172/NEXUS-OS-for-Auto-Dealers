      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -120
      ],
      "name": "Mark Rows Purged",
      "id": "02e79109-0223-4e7a-aa8a-d1e8e939f8c1",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// One audit row per purge run. A retention policy you cannot evidence is not\n// a retention policy, so record what was destroyed and when.\nconst plan = $('Collect Expired Paths').first().json;\n// Supabase's bulk delete returns a JSON ARRAY, and n8n splits an array\n// response into one item per element. `.first().json` therefore handed back\n// the first OBJECT, never the array, so `Array.isArray(del)` was always\n// false, `errors` was always empty, and this node reported SUCCESS for\n// every partial failure. Read all the items instead.\nconst del = $('Delete Storage Objects').all().map(i => i.json);\n\nconst errors = del.filter(d => d && d.error);\n\nreturn [{ json: {\n  workflow: 'NEXUS Retention Purge',\n  status: errors.length ? 'PARTIAL' : 'SUCCESS',\n  summary: 'Retention purge: deleted ' + plan.count + ' KYC document(s) past retain_until'\n           + ' (oldest due ' + plan.oldest_due + ').'\n           + (errors.length ? ' ' + errors.length + ' object(s) failed to delete.' : ''),\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -120
      ],
      "name": "Summarise Purge",
      "id": "45d2416c-a91d-41e4-a0a7-fc8dc7019273"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dsvuoovivysszdoiorch.supabase.co/rest/v1/audit_log",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $json.workflow, status: ($json.delivery ? $json.delivery.status : $json.status), summary: $json.summary + ($json.delivery ? ' ' + $json.delivery.note + ($json.delivery.dropped.length ? ' [' + $json.delivery.dropped.join('; ') + ']' : '') : '') }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -120
