        "options": {}
      }
    },
    {
      "id": "bbbb2222-1234-4123-8123-bbbb22223333",
      "name": "Purge Failed — Rows NOT Marked",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1120,
        380
      ],
      "parameters": {
        "errorMessage": "Retention purge aborted: the Storage delete did not succeed, so purged_at was deliberately NOT written. Leaving the rows unmarked is the safe failure: they stay selectable and tonight's batch will be retried on the next run. Marking them would have told the compliance record those documents were destroyed while the files were still in the bucket, and Find Expired Documents would never look at them again."
      }
    },
    {
      "id": "e3a5b0d7-6f42-4c98-b7e1-aiyopurgedel03",
      "name": "Delivery Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1210,
        -120
      ],
      "parameters": {
        "jsCode": "// Verify every node whose success this compliance row is about to claim.\n// 'Storage Delete Succeeded?' + 'Purge Failed - Rows NOT Marked' already cover\n// the case where the Storage delete errors and purged_at must NOT be written,\n// so this node does not duplicate that gate: it re-states the delete verdict on\n// the row itself and adds the one node nothing looks at - 'Mark Rows Purged',\n// which swallows with onError: continueRegularOutput.\nconst CLAIMED = [\n  { node: 'Delete Storage Objects', what: 'KYC objects destroyed in Storage', critical: true },\n  // Non-critical: the delete already happened and is irreversible, and an\n  // unwritten purged_at self-heals - tomorrow's 'Find Expired Documents' picks\n  // the same rows up again. It must still be NAMED, never hidden.\n  { node: 'Mark Rows Purged', what: 'purged_at written on kyc_documents', critical: false },\n];\n\n// Supabase's bulk delete answers with an ARRAY and n8n splits it into one item\n// per object, so a partial failure can be item 7. Scan EVERY item, not item[0].\nfunction check(c) {\n  let items;\n  try { items = $(c.node).all(); }\n  catch (e) { return { ...c, ok: false, why: 'node did not run on this branch' }; }\n  if (!items.length) return { ...c, ok: false, why: 'node produced no items' };\n  const bad = items.map(i => i.json || {}).filter(j => j.error !== undefined);\n  if (bad.length) {\n    const e = bad[0].error;\n    const m = e && (e.message || e.description) || e;\n    return { ...c, ok: false, why: bad.length + ' of ' + items.length + ' item(s) failed: ' + String(m).slice(0, 250) };\n  }\n  return { ...c, ok: true };\n}\n\nconst results = CLAIMED.map(check);\nconst dropped = results.filter(r => !r.ok);\nconst fatal   = dropped.filter(r => r.critical);\n\nconst status = fatal.length   ? 'FAILED'\n             : dropped.length ? 'PARTIAL'\n             : 'SUCCESS';\n\nreturn [{ json: {\n  ...( $input.first().json || {} ),\n  delivery: {\n    status,\n    verified: results.filter(r => r.ok).map(r => r.what),\n    dropped:  dropped.map(r => r.what + ' - ' + r.why),\n    note: dropped.length\n      ? dropped.length + ' of ' + results.length + ' claimed steps did not land'\n      : 'all ' + results.length + ' claimed steps verified',\n  },\n} }];\n"
      }
    }
  ],
