      ],
      "name": "Find Archive Gaps",
      "id": "7d7e381d-e0c1-44e7-b61f-8f9b70772af7",
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
