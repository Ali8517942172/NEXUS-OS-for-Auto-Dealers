    {
      "parameters": {
        "jsCode": "// This node sits ONLY on the public webhook branch.\n// 'Called by Master Router' connects straight to the next node and never\n// reaches here, so the trusted sub-workflow path is untouched by this guard.\n// That path is live -- execution history shows both webhook and integrated\n// modes in use -- so it must not be rewired.\n//\n// 'Verify JWT' runs with onError = continueRegularOutput, so a rejected token\n// arrives as data rather than as a failed HTTP node. Supabase GET\n// /auth/v1/user returns the user object on success; no .id means rejected.\nconst auth = $input.first().json || {};\nif (!auth.id) {\n  throw new Error('Escalation rejected: unauthorized. A valid Supabase session token is required in the Authorization header.');\n}\n\n// Re-emit the ORIGINAL request untouched so the downstream node sees exactly\n// the shape it saw before this guard was inserted.\nreturn $('EscalationWebhook').all();"
      },
