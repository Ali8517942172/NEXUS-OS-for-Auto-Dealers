      "id": "c360-bitrix-01",
      "name": "Get Customer Directory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Accepts two shapes on purpose.\n//\n// 1. Supabase v_customer_directory — already {id, name, email, phone}. The HTTP\n//    node may hand these over as one item per row, or as a single item holding\n//    the whole array, depending on version; handle both.\n// 2. The old Bitrix24 envelope — { result: [ {ID, NAME, EMAIL:[{VALUE}] ...} ] }.\n//    Kept so that pointing the source back at the CRM needs no edit here.\nconst raw = $input.all().map(i => i.json);\n\nif (raw.length === 1 && raw[0] && Array.isArray(raw[0].result)) {\n  const first = (a) => Array.isArray(a) && a.length ? (a[0].VALUE || null) : null;\n  return raw[0].result.map(c => ({ json: {\n    id: String(c.ID),\n    name: [c.NAME, c.LAST_NAME].filter(Boolean).join(' ').trim() || c.TITLE || null,\n    email: first(c.EMAIL),\n    phone: first(c.PHONE)\n  } })).filter(i => i.json.email || i.json.phone);\n}\n\nlet rows = raw;\nif (raw.length === 1 && Array.isArray(raw[0])) rows = raw[0];\n\nreturn rows\n  .filter(r => r && (r.email || r.phone))\n  .map(r => ({ json: {\n    id: String(r.id != null ? r.id : (r.email || '')),\n    name: r.name != null ? r.name : (r.customer_name || null),\n    email: r.email || null,\n    phone: r.phone || null\n  } }));\n"
      },
      "id": "c360-norm-01",
      "name": "Normalise Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        336,
        576
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dsvuoovivysszdoiorch.supabase.co/rest/v1/audit_log",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'Customer 360 Aggregation', status: $json.delivery.status, lead_name: ($json.lead_name || $json.name || null), lead_email: ($json.lead_email || $json.email || null), summary: ('Profile upsert - ' + ($json.total_emails ?? 0) + ' email(s), ' + ($json.total_slack_messages ?? 0) + ' Slack mention(s) aggregated. ' + $json.delivery.note + ($json.delivery.dropped.length ? ': ' + $json.delivery.dropped.join(' | ') : '')).substring(0, 500), logged_at: $now.toISO() }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "audit-customer_3",
      "name": "Audit Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        304
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "credentials": {
        "supabaseApi": {
          "id": "dv4OeARarErZLHCj",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9f3c21ad-7b40-4e6a-9c11-c0d7a5e18b41",
      "name": "Delivery Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1464,
        304
      ],
      "parameters": {
        "jsCode": "// Every node whose success the Audit Log below is about to claim.\n// Gmail / Slack are reads: losing them does not undo anything and the profile\n// row still lands, so they are PARTIAL, not FAILED - but the counts written to\n// customer_360_profiles are then guesses and must be named, never hidden.\nconst CLAIMED = [\n  { node: 'Supabase - Upsert Profile', what: 'customer_360_profiles upsert', critical: true },\n  { node: 'Gmail - Get Emails',        what: 'Gmail history for this customer', critical: false },\n  { node: 'Slack - Search Mentions',   what: 'Slack mentions for this customer', critical: false },\n];\n\nfunction check(c) {\n  let items;\n  try { items = $(c.node).all(); }\n  catch (e) { return { ...c, ok: false, why: 'node did not run on this branch' }; }\n  if (!items.length) return { ...c, ok: false, why: 'node produced no items' };\n  const j = items[0].json || {};\n  if (j.error !== undefined) {\n    const m = j.error && (j.error.message || j.error.description) || j.error;\n    return { ...c, ok: false, why: String(m).slice(0, 300) };\n  }\n  return { ...c, ok: true };\n}\n\nconst results  = CLAIMED.map(check);\nconst dropped  = results.filter(r => !r.ok);\nconst fatal    = dropped.filter(r => r.critical);\n\nconst status = fatal.length  ? 'FAILED'\n             : dropped.length ? 'PARTIAL'\n             : 'SUCCESS';\n\n// The upsert runs with Prefer: return=minimal, so its own output carries no\n// profile fields. Read them back from the node that built them.\nlet profile = {};\ntry { profile = $('Transform & Unify').first().json || {}; } catch (e) { profile = {}; }\n\nreturn [{ json: {\n  ...profile,\n  ...( $input.first().json || {} ),\n  delivery: {\n    status,\n    verified: results.filter(r => r.ok).map(r => r.what),\n    dropped:  dropped.map(r => r.what + ' - ' + r.why),\n    note: dropped.length\n      ? dropped.length + ' of ' + results.length + ' claimed steps did not land'\n      : 'all ' + results.length + ' claimed steps verified',\n  },\n} }];"
      }
    }
  ],
