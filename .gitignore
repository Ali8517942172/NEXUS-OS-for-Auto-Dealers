# .github/workflows/ WAS IGNORED HERE, and that is why this repository had no
# continuous integration: twelve pull requests merged to main with no automated
# check because every workflow file anyone wrote was invisible to git. The line
# is removed deliberately (7 Sep 2026). Do not restore it — a workflow you
# cannot commit is a workflow that does not run.
.vercel
claude_desktop_config.json
*.timestamp-*.mjs

# DB dumps hold encrypted n8n credentials; local backups and build output
n8n_backup*.sql
*.bak

# Staging area for files an agent could not delete directly (device_bash cannot
# rm). Review the contents, then delete the folder yourself.
_to_delete/
_to_delete_git_locks/

# Local backup archives — not source
backups/

# Round patches — a redundant record once the change itself is committed,
# and 0.5-1.5 MB each.
*.patch
COMMIT_MSG.txt
_to_delete_build/

# Gate evidence: a live catalogue snapshot, regenerated on demand and stale after 24h.
apps/executive-dashboard/.gate/
