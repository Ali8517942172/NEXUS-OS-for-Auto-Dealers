  {
   "id": "da68e715",
   "name": "Parse Input",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    -120
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "// Exactly one tenant. Two tenant_members rows for one auth_user_id means this\n// endpoint cannot pick one on the caller's behalf -- refuse rather than guess.\nconst rows = $('Tenant For JWT User').all().map(i => i.json).filter(Boolean);\nif (rows.length !== 1) {\n  throw new Error('NX1007_TENANT_UNRESOLVED: caller belongs to ' + rows.length + ' dealership(s). '\n    + 'A test send needs exactly one.');\n}\nconst tenant_id = rows[0].tenant_id;\nconst body = $('Channel Test Send Webhook').first().json.body || {};\nconst integration_id = String(body.integration_id || '').trim();\nconst recipient = String(body.recipient_phone || '').replace(/[^0-9]/g, '');\nconst UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!UUID.test(integration_id)) {\n  throw new Error('NX1007_BAD_INPUT: integration_id must be the uuid this channel was registered with.');\n}\nif (recipient.length < 8) {\n  throw new Error('NX1007_BAD_INPUT: recipient_phone is required -- who should the test message go to?');\n}\nreturn [{ json: { tenant_id, integration_id, recipient,\n  verified_by: $('Verify JWT').first().json.email || $('Verify JWT').first().json.id } }];"
   }
  },
