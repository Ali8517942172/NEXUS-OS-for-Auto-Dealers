   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "// A 2xx with no messages[0].id is not an accept -- nexus_channel_mark_active is\n// never called on an unfalsifiable success. See ops/whatsapp-cloud-send/SEND-DESIGN.md #4.\nconst r = $input.first().json || {};\nconst status = r.statusCode ?? r.status ?? null;\nconst body = r.body ?? r;\nconst wamid = body && body.messages && body.messages[0] && body.messages[0].id;\nconst ok = Number(status) >= 200 && Number(status) < 300 && !!wamid;\nreturn [{ json: { ok, status, wamid: wamid || null, body } }];"
   }
